// Prisma Schema for AI Code Reviewer & Bug Detection Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum IssueCategory {
  BUG
  SECURITY
  PERFORMANCE
  QUALITY
  MAINTAINABILITY
  COMPLEXITY
  BEST_PRACTICE
}

enum IssueStatus {
  OPEN
  FIXED
  IGNORED
  ACCEPTED
}

enum ReviewSourceType {
  MANUAL
  ZIP_UPLOAD
  GITHUB_REPO
  GITHUB_PR
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  passwordHash      String?            @map("password_hash")
  avatarUrl         String?            @map("avatar_url")
  provider          String?            @default("email")
  role              UserRole           @default(USER)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  projects          Project[]
  reviews           Review[]
  aiConversations   AIConversation[]
  githubConnections GitHubConnection[]
  usageRecords      UsageRecord[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Project {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  name          String
  description   String?
  language      String?
  repositoryUrl String?       @map("repository_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files         ProjectFile[]
  reviews       Review[]

  @@index([userId])
  @@map("projects")
}

model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  path        String
  language    String
  sizeBytes   Int      @map("size_bytes")
  contentHash String   @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_files")
}

model Review {
  id                   String           @id @default(uuid())
  projectId            String?          @map("project_id")
  userId               String           @map("user_id")
  sourceType           ReviewSourceType @default(MANUAL) @map("source_type")
  commitSha            String?          @map("commit_sha")
  branchName           String?          @map("branch_name")
  status               ReviewStatus     @default(QUEUED)
  overallScore         Float?           @map("overall_score")
  securityScore        Float?           @map("security_score")
  bugScore             Float?           @map("bug_score")
  performanceScore     Float?           @map("performance_score")
  maintainabilityScore Float?           @map("maintainability_score")
  qualityScore         Float?           @map("quality_score")
  totalIssues          Int              @default(0) @map("total_issues")
  code                 String?          @db.Text
  language             String?          @default("javascript")
  startedAt            DateTime?        @map("started_at")
  completedAt          DateTime?        @map("completed_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  project              Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues               ReviewIssue[]
  aiConversations      AIConversation[]
  pullRequests         PullRequest[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewIssue {
  id             String        @id @default(uuid())
  reviewId       String        @map("review_id")
  filePath       String        @map("file_path")
  lineStart      Int?          @map("line_start")
  lineEnd        Int?          @map("line_end")
  columnStart    Int?          @map("column_start")
  columnEnd      Int?          @map("column_end")
  category       IssueCategory
  severity       IssueSeverity
  title          String
  description    String        @db.Text
  impact         String?       @db.Text
  recommendation String?       @db.Text
  ruleId         String?       @map("rule_id")
  source         String
  fingerprint    String
  status         IssueStatus   @default(OPEN)
  createdAt      DateTime      @default(now()) @map("created_at")

  review         Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fixes          IssueFix[]

  @@index([reviewId])
  @@index([severity])
  @@index([category])
  @@index([fingerprint])
  @@map("review_issues")
}

model IssueFix {
  id            String      @id @default(uuid())
  issueId       String      @map("issue_id")
  originalCode  String      @map("original_code") @db.Text
  suggestedCode String      @map("suggested_code") @db.Text
  explanation   String      @db.Text
  status        IssueStatus @default(OPEN)
  createdAt     DateTime    @default(now()) @map("created_at")

  issue         ReviewIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("issue_fixes")
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  reviewId  String      @map("review_id")
  title     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
  @@index([reviewId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  role           String
  content        String         @db.Text
  tokenUsage     Int?           @map("token_usage")
  createdAt      DateTime       @default(now()) @map("created_at")

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model GitHubConnection {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  githubUserId         String             @map("github_user_id")
  username             String
  encryptedAccessToken String             @map("encrypted_access_token")
  scopes               String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories         GitHubRepository[]

  @@index([userId])
  @@map("github_connections")
}

model GitHubRepository {
  id            String           @id @default(uuid())
  connectionId  String           @map("connection_id")
  githubRepoId  String           @map("github_repo_id")
  owner         String
  name          String
  fullName      String           @map("full_name")
  defaultBranch String           @default("main") @map("default_branch")
  private       Boolean          @default(false)
  htmlUrl       String           @map("html_url")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  connection    GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pullRequests  PullRequest[]

  @@index([connectionId])
  @@map("github_repositories")
}

model PullRequest {
  id           String           @id @default(uuid())
  repositoryId String           @map("repository_id")
  githubPrId   String           @map("github_pr_id")
  number       Int
  title        String
  branchName   String           @map("branch_name")
  baseBranch   String           @map("base_branch")
  commitSha    String           @map("commit_sha")
  status       String           @default("open")
  reviewId     String?          @map("review_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  review       Review?          @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@map("pull_requests")
}

model UsageRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  units     Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("usage_records")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipHash       String?  @map("ip_hash")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}
