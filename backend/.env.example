# ===================================================================
# AI Code Reviewer & Bug Detection Platform — Backend Environment Configuration
# ===================================================================

# -------------------------------------------------------------------
# 1. SERVER & RUNTIME
# -------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# -------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Supabase or Local Docker)
# -------------------------------------------------------------------
# Application runtime pool connection string
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/aicode_reviewer?schema=public"

# Migration / direct connection string (Required by Supabase / Prisma)
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/aicode_reviewer?schema=public"

# -------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# -------------------------------------------------------------------
# Cryptographically secure secret key (DO NOT expose to frontend)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------
# 4. AI ENGINE PROVIDER ABSTRACTION
# Allowed values: gemini | openai | mock
# -------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------------------
# 5. GOOGLE OAUTH CREDENTIALS (Optional for Google Sign In)
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# -------------------------------------------------------------------
# 6. GITHUB OAUTH CREDENTIALS (Optional for Repo & PR Scanning)
# -------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/github/callback

# -------------------------------------------------------------------
# 7. REDIS & CACHING (Optional)
# -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -------------------------------------------------------------------
# 8. CORS ALLOWLIST ORIGIN
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
